# Clé API NVIDIA NIM (build.nvidia.com) — NE JAMAIS committer la vraie valeur
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modèle vision par défaut
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
PORT=8000
# Timeout de l'appel modèle en ms (défaut 45000, borné 1000–85000 ; doit rester < proxy_read_timeout nginx 90s)
NVIDIA_TIMEOUT_MS=45000
# Niveau de log Fastify (les corps, images, prompts et sorties modèle ne sont jamais journalisés)
LOG_LEVEL=info
