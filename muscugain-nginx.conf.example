# CONFIGURATION NGINX POUR LE REVERSE PROXY EXISTANT
# Copier ce fichier dans /etc/nginx/sites-available/ ou /etc/nginx/conf.d/
# Ensuite faire: sudo systemctl restart nginx

# Configuration en amont (upstream) pour MuscuGain
upstream muscugain_backend {
    server muscugain-app:80;
}

# Redirection HTTP → HTTPS
server {
    listen 80;
    server_name muscugain.woutils.com;

    location / {
        return 301 https://$server_name$request_uri;
    }
}

# Configuration HTTPS pour MuscuGain
server {
    listen 443 ssl http2;
    server_name muscugain.woutils.com;

    # Certificats SSL Let's Encrypt
    # À adapter selon votre configuration de renouvellement automatique
    ssl_certificate /etc/letsencrypt/live/muscugain.woutils.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/muscugain.woutils.com/privkey.pem;

    # Configuration SSL de sécurité
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_stapling on;
    ssl_stapling_verify on;

    # Headers de sécurité
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    # Logs
    access_log /var/log/nginx/muscugain_access.log;
    error_log /var/log/nginx/muscugain_error.log warn;

    # Compression Gzip
    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css text/xml text/javascript
               application/json application/javascript application/xml+rss;

    # Proxy vers le conteneur Docker MuscuGain
    location / {
        proxy_pass http://muscugain_backend;
        proxy_http_version 1.1;

        # Headers proxy
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $server_name;

        # Paramètres de connexion
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_cache_bypass $http_upgrade;

        # Upgrade pour WebSocket (si utilisé)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
    }
}
