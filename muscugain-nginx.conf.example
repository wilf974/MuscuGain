# CONFIGURATION NGINX POUR LE REVERSE PROXY EXISTANT
# VERSION SIMPLIFIÉE - Compatible avec les autres domaines
# Copier ce fichier dans /etc/nginx/sites-available/muscugain.conf
# Ensuite: sudo ln -s /etc/nginx/sites-available/muscugain.conf /etc/nginx/sites-enabled/
# Puis: sudo nginx -t && sudo systemctl restart nginx

# Redirection HTTP → HTTPS
server {
    listen 80;
    server_name muscugain.woutils.com;

    location / {
        return 301 https://$server_name$request_uri;
    }
}

# Configuration HTTPS pour MuscuGain
# NOTE: Les options SSL (protocoles, ciphers, sessions) sont partagées entre tous les domaines
server {
    listen 443 ssl http2;
    server_name muscugain.woutils.com;

    # Certificats SSL Let's Encrypt
    ssl_certificate /etc/letsencrypt/live/muscugain.woutils.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/muscugain.woutils.com/privkey.pem;

    # Headers de sécurité spécifiques à ce domaine
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Logs
    access_log /var/log/nginx/muscugain_access.log;
    error_log /var/log/nginx/muscugain_error.log warn;

    # Proxy vers le conteneur Docker MuscuGain
    location / {
        proxy_pass http://muscugain-app:80;
        proxy_http_version 1.1;

        # Headers proxy
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Paramètres de connexion
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
