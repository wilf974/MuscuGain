# Configuration pour MuscuGain Docker Deployment

# Email pour les certificats Let's Encrypt (requis)
CERTBOT_EMAIL=admin@woutils.com

# Domaines (adapter selon vos besoins)
DOMAIN_MUSCUGAIN=muscugain.woutils.com

# Environnement
ENVIRONMENT=production

# Optionnel: Certificats personnalisés (laisser vide pour Let's Encrypt)
# SSL_CERT_PATH=/etc/nginx/ssl/
# SSL_KEY_PATH=/etc/nginx/ssl/

# Optionnel: Configuration Nginx avancée
# WORKER_PROCESSES=auto
# WORKER_CONNECTIONS=1024
# CLIENT_MAX_BODY_SIZE=50M
